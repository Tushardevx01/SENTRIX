{
  "name": "sentrix-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SENTRIX: Intelligent Website Threat Detection & Trust Intelligence Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace=@sentrix/web run dev",
    "dev:api": "npm --workspace=@sentrix/api run dev",
    "dev:scanner": "cd services/scanner && .venv/bin/python -m uvicorn app.main:app --reload --port 8001",
    "build:shared": "npm --workspace=@sentrix/shared run build",
    "build:api": "npm --workspace=@sentrix/api run build",
    "build:web": "npm --workspace=@sentrix/web run build",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "compile:contracts": "node contracts/compile.js",
    "test": "npm --workspace=@sentrix/api test",
    "test:scanner": "cd services/scanner && .venv/bin/pytest",
    "migrate:indexes": "npm --workspace=@sentrix/api run migrate:indexes",
    "migrate:indexes:dry-run": "npm --workspace=@sentrix/api run migrate:indexes:dry-run",
    "create:admin": "npm --workspace=@sentrix/api run create:admin"
  }
}
