# ==============================================================================
# SENTRIX - Unified Platform Configuration (.env.example)
# ==============================================================================
# Copy this file to '.env' at the repository root:
#   cp .env.example .env
#
# SENTRIX follows a single root .env policy. All services (apps/api,
# services/scanner, apps/web) automatically resolve variables from the repo root.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MongoDB Database (Owned strictly by apps/api)
# ------------------------------------------------------------------------------
# Connection URI for MongoDB 7.0+ (Local Docker or MongoDB Atlas)
# Docker: mongodb://127.0.0.1:27017/sentrix
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sentrix?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/sentrix

# Optional test database URI override for integration test runners
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/sentrix_test

# ------------------------------------------------------------------------------
# 2. Service Ports & Runtime Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=8000
API_PORT=8000
SCANNER_PORT=8001

# ------------------------------------------------------------------------------
# 3. Inter-Service Security & Authentication
# ------------------------------------------------------------------------------
# Shared secret for Fastify Gateway <-> Python Scanner threat engine communication
# Passed via the 'X-Scanner-Secret' HTTP header. Minimum 16 characters required.
SCANNER_API_SECRET=sentrix-dev-scanner-secret-minimum-16-chars-key!

# URL where the Fastify Gateway can contact the Python threat engine
# Local: http://127.0.0.1:8001
# Docker Compose: http://scanner:8001
# Production (Render): https://sentrix-scanner.onrender.com
SCANNER_INTERNAL_URL=http://127.0.0.1:8001

# JWT Secret for Analyst and Admin session authentication (HMAC-SHA256)
# Minimum 32 characters. Production strictly requires a non-default secret.
JWT_SECRET=sentrix-dev-jwt-secret-minimum-32-characters-key!

# ------------------------------------------------------------------------------
# 4. Web Frontend (apps/web - Next.js)
# ------------------------------------------------------------------------------
# Public API URL used by the browser to communicate with the Fastify Gateway
# Local: http://localhost:8000
# Production: https://sentrix-1-az9t.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Permitted CORS Origin for API requests
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 5. Module C: Web3 Blockchain Registry (ThreatRegistry.sol)
# ------------------------------------------------------------------------------
# Enable or disable blockchain commitment integration
BLOCKCHAIN_ENABLED=true

# EVM JSON-RPC provider endpoint
# Local Hardhat Node: http://127.0.0.1:8545
# Sepolia Testnet: https://eth-sepolia.g.alchemy.com/v2/your-api-key
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Signer private key for anchoring threat commitments (0x-prefixed 32-byte hex)
# In development on local RPC, defaults to Hardhat Account #0
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Deployed ThreatRegistry smart contract address (optional; auto-deploys on local EVM)
THREAT_REGISTRY_CONTRACT_ADDRESS=

# ------------------------------------------------------------------------------
# 6. External Threat Intelligence Feeds (Optional)
# ------------------------------------------------------------------------------
# abuse.ch URLhaus malware and phishing feed connector
URLHAUS_ENABLED=true
URLHAUS_API_KEY=

# Google Safe Browsing v4 API Key
GOOGLE_SAFE_BROWSING_API_KEY=

# Optional LLM API Key for AI threat explanations
LLM_API_KEY=
